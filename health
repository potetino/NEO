; =============================================
; Функция расчета урона герою
; Вход: R0 - сила удара (0-10)
; Использует: HEALTH - текущее здоровье (0-10)
;            10 = максимальное здоровье
;            0 = Game Over
; =============================================

HLTH:   .WORD   10      ; текущее здоровье героя (0-10)
GAMEOV: .WORD   0       ; флаг Game Over (0-норма, 1-конец)

; Подпрограмма нанесения урона
; Вход: R0 - сила урона (0-10)
DMG:    MOV     HLTH, R1    ; текущее здоровье
        SUB     R0, R1      ; вычитаем урон
        BGT     1$       	; если здоровье > 0
        CLR     R1          ; иначе обнуляем здоровье
        MOV     #1, GAMEOV  ; устанавливаем флаг Game Over
        BR      2$
1$:  	CMP     R1, #10     ; проверяем максимум
        BLOS    2$
        MOV     #10, R1     ; ограничиваем максимум 10
2$:  	MOV     R1, HLTH    ; сохраняем новое здоровье
        RETURN

; Подпрограмма лечения/восстановления здоровья
; Вход: R0 - количество лечения (0-10)
HEAL:   MOV     HLTH, R1    ; текущее здоровье
        ADD     R0, R1      ; добавляем лечение
        CMP     R1, #10     ; проверяем максимум
        BLOS    1$
        MOV     #10, R1     ; ограничиваем максимум 10
1$: 	MOV     R1, HLTH    ; сохраняем новое здоровье
        CLR     GAMEOV      ; сбрасываем флаг Game Over
        RETURN

; Подпрограмма проверки Game Over
; Выход: Z=1 - игра продолжается, Z=0 - Game Over
CHKGAM: TST     HLTH        ; проверяем здоровье
        BNE     1$      	; если не 0 - продолжаем
        MOV     #1, GAMEOV  ; устанавливаем флаг
1$:		TST     GAMEOV      ; устанавливаем флаги
        RETURN

; Подпрограмма отображения здоровья на экране
; Использует формат аналогичный FPS счетчику
SHWHLT: MOV     HLTH, R0
        MOV     #MSGHTH, R5
        CALL    DIGI2       ; используем ту же функцию для цифр
        MOV     #MSGHTH, R0
        CALL    PRIST8      ; выводим на экран
        RETURN

; =============================================
; Подпрограмма DIGI2 - преобразование числа в две ASCII цифры
; Вход:  R0 - число (0-99) для преобразования
;        R5 - указатель на буфер для результата (2 байта)
; Выход: В буфер записаны две ASCII цифры
; Использует: R0, R1, R5
; =============================================

DIGI2:  CMP     R0, #99.        ; Сравниваем число с 99
        BLOS    10$          	; Если R0 <= 99, переходим к преобразованию
                                ; (Branch on Lower or Same)
        
        MOV     #99., R0        ; Если число > 99, ограничиваем его значением 99
                                ; чтобы избежать переполнения при преобразовании

; Преобразование числа в две цифры
10$: 	MOV     R0, R1          ; Сохраняем исходное число в R1
        CLR     R0              ; Очищаем R0 (готовим для операции DIV)
        
        ; Делим число на 10 чтобы получить десятки и единицы
        DIV     #10., R0        ; R0 = R0:R1 / 10
                                ; Результат: R0 = частное (десятки)
                                ;          R1 = остаток (единицы)
                                ; Например: 57 → R0=5, R1=7
        
        ; Преобразуем десятки в ASCII
        ADD     #'0, R0         ; R0 = R0 + '0' (преобразуем цифру в ASCII)
                                ; Например: 5 + 60(8) = 65(8) = '5'
        
        ; Преобразуем единицы в ASCII  
        ADD     #'0, R1         ; R1 = R1 + '0' (преобразуем цифру в ASCII)
                                ; Например: 7 + 60(8) = 67(8) = '7'
        
        ; Сохраняем цифры в буфер
        MOVB    R0, (R5)+       ; Записываем старшую цифру (десятки) в буфер
                                ; и увеличиваем указатель R5
                                
        MOVB    R1, (R5)+       ; Записываем младшую цифру (единицы) в буфер  
                                ; и увеличиваем указатель R5
        
        RETURN                  ; Возврат из подпрограммы
        
; =============================================
; Подпрограмма PRIST8 - вывод строки символов на экран
; Использует битовый шрифт 8x8 пикселей
; Вход: R0 - указатель на строку (ASCIIZ)
; Использует: R1, R2, R5
; =============================================

PRIST8:	MOV	VADDR, R5      			; R5 = начальный адрес видеопамяти
		MOV	#64., R2       			; R2 = 64 (шаг между строками экрана)
			    		   			; (это ширина экрана в байтах/пикселях)
	
; Начало цикла по символам строки
10$:	MOVB	(R0)+, R1     	 	; Читаем очередной символ из строки, инкрементируем R0
		BEQ	99$            			; Если символ = 0 (конец строки), выходим
	
		SUB	#'0, R1        			; Преобразуем ASCII в числовое значение
			    					; '0'=60(8) → 0, '1'=61(8) → 1, и т.д.
	
; Вычисляем адрес символа в шрифте:
		ASL	R1            			; R1 = R1 * 2  (сдвиг влево на 1 бит)
		ASL	R1             			; R1 = R1 * 4  (сдвиг влево на 2 бита)  
		ASL	R1             			; R1 = R1 * 8  (сдвиг влево на 3 бита)
			    					; Теперь R1 содержит смещение в таблице шрифтов
			    					; Каждый символ занимает 8 байт
	
		ADD	#FONT8, R1     			; R1 = адрес данных символа в таблице FONT8
	
; Рисуем символ 8x8 пикселей:
		.REPT	8.             		; Повторить 8 раз (для 8 строк символа)
		MOVB	(R1)+, @R5    		; Копируем 1 байт (8 пикселей) из шрифта в видеопамять
		ADD	R2, R5       	 		; Переходим на следующую строку экрана (+64 байта)
		.ENDR                 		; Конец повторения
	
; Подготовка к следующему символу:
		SUB	#64.*8.-1, R5  			; Возвращаемся назад по вертикали (8 строк * 64)
			    					; и переходим к следующей позиции по горизонтали (+1)
			    					; 64*8 = 512 (вернуться на 8 строк вверх)
			    					; -1 = сместиться на 1 байт вправо
	
		BR	10$            			; Переход к обработке следующего символа
	
; Конец строки - возврат из подпрограммы
99$:	RETURN             ; Возврат из подпрограммы


