;=================================================================
; ПОЛНАЯ СИСТЕМА КОЛЛИЗИЙ ДЛЯ ИГРЫ
;=================================================================

; СТРУКТУРА ОБЪЕКТА ДОПОЛНЕНА ПОЛЕМ TYPE
        TYPE    = 30          ; ТИП ОБЪЕКТА (СМЕЩЕНИЕ В СТРУКТУРЕ)

; ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ
OBJCNT:: .WORD   0             ; СЧЕТЧИК ОБЪЕКТОВ
OBJLST:: .BLKW   20            ; СПИСОК АДРЕСОВ ОБЪЕКТОВ (МАКС 20)

; КОНСТАНТЫ ТИПОВ ОБЪЕКТОВ
TYPPLR  = 0                  ; ИГРОК
TYPENM  = 1                  ; ВРАГ
TYPBUL  = 2                  ; ПУЛЯ
TYPBNS  = 3                  ; БОНУС
TYPWAL  = 4                  ; СТЕНА/ПРЕПЯТСТВИЕ
TYPTRP  = 5                  ; ЛОВУШКА
TYPPRT  = 6                  ; ПОРТАЛ
TYPDR   = 7                  ; ДВЕРЬ
TYPKEY  = 10                  ; КЛЮЧ
TYPEXP  = 11                  ; ВЗРЫВ

;=================================================================
; БАЗОВАЯ ФУНКЦИЯ ПРОВЕРКИ КОЛЛИЗИИ ДВУХ ОБЪЕКТОВ
;=================================================================
; ВХОД:  R0 = АДРЕС ПЕРВОГО ОБЪЕКТА
;        R1 = АДРЕС ВТОРОГО ОБЪЕКТА  
; ВЫХОД: R0 = 1 ЕСЛИ ЕСТЬ КОЛЛИЗИЯ, 0 ЕСЛИ НЕТ
COLCHE:: MOV     R2, -(SP)      ; СОХРАНЯЕМ РЕГИСТРЫ
        MOV     R3, -(SP)
        MOV     R4, -(SP)
        MOV     R5, -(SP)
        
        ; ЗАГРУЖАЕМ ПЕРВЫЙ ОБЪЕКТ
        MOV     POSX(R0), R2    ; R2 = X1
        MOV     POSY(R0), R3    ; R3 = Y1
        MOV     ADSPR(R0), R4   ; R4 = АДРЕС СПРАЙТА OBJ1
        MOV     SIZEX(R4), R4   ; R4 = SIZEX1
        MOV     ADSPR(R0), R5   ; R5 = АДРЕС СПРАЙТА OBJ1  
        MOV     SIZEY(R5), R5   ; R5 = SIZEY1

        ; ВЫЧИСЛЯЕМ ГРАНИЦЫ ПЕРВОГО ОБЪЕКТА
        ADD     R2, R4          ; R4 = X1 + SIZEX1 (ПРАВАЯ ГРАНИЦА)
        ADD     R3, R5          ; R5 = Y1 + SIZEY1 (НИЖНЯЯ ГРАНИЦА)

        ; СОХРАНЯЕМ ГРАНИЦЫ ПЕРВОГО ОБЪЕКТА В СТЕКЕ
        MOV     R2, -(SP)       ; [SP] = X1
        MOV     R3, -(SP)       ; [SP+2] = Y1
        MOV     R4, -(SP)       ; [SP+4] = X1+SIZEX1
        MOV     R5, -(SP)       ; [SP+6] = Y1+SIZEY1

        ; ЗАГРУЖАЕМ ВТОРОЙ ОБЪЕКТ
        MOV     POSX(R1), R2    ; R2 = X2
        MOV     POSY(R1), R3    ; R3 = Y2
        MOV     ADSPR(R1), R4   ; R4 = АДРЕС СПРАЙТА OBJ2
        MOV     SIZEX(R4), R4   ; R4 = SIZEX2
        MOV     ADSPR(R1), R5   ; R5 = АДРЕС СПРАЙТА OBJ2
        MOV     SIZEY(R5), R5   ; R5 = SIZEY2

        ; ВЫЧИСЛЯЕМ ГРАНИЦЫ ВТОРОГО ОБЪЕКТА
        ADD     R2, R4          ; R4 = X2 + SIZEX2
        ADD     R3, R5          ; R5 = Y2 + SIZEY2

        ; ПРОВЕРЯЕМ КОЛЛИЗИЮ AABB

        ; ЕСЛИ X1+SIZEX1 < X2 -> НЕТ КОЛЛИЗИИ
        CMP     4(SP), R2       ; СРАВНИВАЕМ (X1+SIZEX1) С X2
        BLT     1$

        ; ЕСЛИ X2+SIZEX2 < X1 -> НЕТ КОЛЛИЗИИ
        CMP     R4, (SP)        ; СРАВНИВАЕМ (X2+SIZEX2) С X1
        BLT     1$

        ; ЕСЛИ Y1+SIZEY1 < Y2 -> НЕТ КОЛЛИЗИИ
        CMP     6(SP), R3       ; СРАВНИВАЕМ (Y1+SIZEY1) С Y2
        BLT     1$

        ; ЕСЛИ Y2+SIZEY2 < Y1 -> НЕТ КОЛЛИЗИИ
        CMP     R5, 2(SP)       ; СРАВНИВАЕМ (Y2+SIZEY2) С Y1
        BLT     1$

        ; ЕСТЬ КОЛЛИЗИЯ
        MOV     #1, R0
        BR      2$

1$:     MOV     #0, R0          ; НЕТ КОЛЛИЗИИ

2$:  ; ВОССТАНАВЛИВАЕМ СТЕК (4 СЛОВА = 8 БАЙТ)
        ADD     #10, SP          ; POP 4 WORDS

        MOV     (SP)+, R5       ; ВОССТАНАВЛИВАЕМ РЕГИСТРЫ
        MOV     (SP)+, R4
        MOV     (SP)+, R3
        MOV     (SP)+, R2
        RETURN
;===================================================================
; ДОБАВЛЕНИЕ ОБЪЕКТА В СПИСОК ДЛЯ ПРОВЕРКИ КОЛЛИЗИЙ
;===================================================================
; ВХОД: R0 = АДРЕС ОБЪЕКТА
ADDOBJ:: MOV     R1, -(SP)
        MOV     OBJCNT, R1      ; ТЕКУЩЕЕ КОЛИЧЕСТВО ОБЪЕКТОВ
        CMP     R1, #40.        ; МАКСИМУМ 20 ОБЪЕКТОВ * 2 БАЙТА
        BGE     1$              ; ЕСЛИ ПЕРЕПОЛНЕНИЕ - ВЫХОДИМ
        
        ASL     R1              ; УМНОЖАЕМ НА 2 (РАЗМЕР СЛОВА)
        MOV     R0, OBJLST(R1)  ; ДОБАВЛЯЕМ АДРЕС В СПИСОК
        INC     OBJCNT          ; УВЕЛИЧИВАЕМ СЧЕТЧИК
        
1$:     MOV     (SP)+, R1
        RETURN
;==================================================================
; УДАЛЕНИЕ ОБЪЕКТА ИЗ СПИСКА
;==================================================================
; ВХОД: R0 = АДРЕС ОБЪЕКТА
REMOBJ:: MOV     R1, -(SP)
        MOV     R2, -(SP)
        MOV     R3, -(SP)
        
        MOV     OBJCNT, R1      ; КОЛИЧЕСТВО ОБЪЕКТОВ
        BEQ     5$              ; ЕСЛИ СПИСОК ПУСТ - ВЫХОДИМ
        
        MOV     #OBJLST, R2     ; НАЧАЛО СПИСКА
        CLR     R3              ; ИНДЕКС ТЕКУЩЕГО ЭЛЕМЕНТА
        
1$:     CMP     R0, (R2)        ; СРАВНИВАЕМ С ТЕКУЩИМ ОБЪЕКТОМ
        BEQ     2$              ; НАШЛИ ОБЪЕКТ ДЛЯ УДАЛЕНИЯ
        ADD     #2, R2          ; СЛЕДУЮЩИЙ ЭЛЕМЕНТ
        INC     R3              ; УВЕЛИЧИВАЕМ ИНДЕКС
        CMP     R3, OBJCNT      ; ПРОВЕРЯЕМ КОНЕЦ СПИСКА
        BLT     1$              ; ПРОДОЛЖАЕМ ПОИСК
        BR      5$              ; НЕ НАШЛИ - ВЫХОДИМ

2$:     ; СДВИГАЕМ ОСТАВШИЕСЯ ОБЪЕКТЫ
        MOV     R2, R0          ; R0 = ТЕКУЩАЯ ПОЗИЦИЯ
        MOV     OBJCNT, R1
        SUB     R3, R1          ; R1 = КОЛИЧЕСТВО ОСТАВШИХСЯ ЭЛЕМЕНТОВ
        DEC     R1              ; ИСКЛЮЧАЕМ УДАЛЯЕМЫЙ
        BEQ     4$              ; ЕСЛИ ПОСЛЕДНИЙ - ПРОПУСТИТЬ СДВИГ
        
3$:     MOV     2(R0), (R0)+    ; СДВИГАЕМ ЭЛЕМЕНТЫ
        SOB     R1, 3$

4$:     DEC     OBJCNT          ; УМЕНЬШАЕМ СЧЕТЧИК

5$:     MOV     (SP)+, R3
        MOV     (SP)+, R2
        MOV     (SP)+, R1
        RETURN
;====================================================================
; ПРОВЕРКА КОЛЛИЗИИ С ЛЮБЫМ ОБЪЕКТОМ В СПИСКЕ
;====================================================================
; ВХОД:  R0 = АДРЕС ОСНОВНОГО ОБЪЕКТА
; ВЫХОД: R0 = АДРЕС ОБЪЕКТА КОЛЛИЗИИ (0 ЕСЛИ НЕТ)
;        R1 = ТИП ОБЪЕКТА КОЛЛИЗИИ
COLANY:: MOV     R2, -(SP)
        MOV     R3, -(SP)
        MOV     R4, -(SP)
        
        MOV     OBJCNT, R4      ; КОЛИЧЕСТВО ОБЪЕКТОВ ДЛЯ ПРОВЕРКИ
        BEQ     3$              ; ЕСЛИ СПИСОК ПУСТ - ВЫХОДИМ
        
        MOV     #OBJLST, R3     ; УКАЗАТЕЛЬ НА СПИСОК ОБЪЕКТОВ
        MOV     R0, R2          ; СОХРАНЯЕМ АДРЕС ОСНОВНОГО ОБЪЕКТА
        
1$:     MOV     (R3)+, R1       ; БЕРЕМ СЛЕДУЮЩИЙ ОБЪЕКТ ИЗ СПИСКА
        CMP     R1, R2          ; НЕ ПРОВЕРЯЕМ КОЛЛИЗИЮ С САМИМ СОБОЙ
        BEQ     2$
        
        ; ПРОВЕРЯЕМ КОЛЛИЗИЮ МЕЖДУ OBJ1 (R2) И OBJ2 (R1)
        MOV     R2, R0
        CALL    COLCHE          ; ВЫЗЫВАЕМ БАЗОВУЮ ФУНКЦИЮ КОЛЛИЗИИ
        TST     R0
        BEQ     2$              ; ЕСЛИ НЕТ КОЛЛИЗИИ - СЛЕДУЮЩИЙ ОБЪЕКТ
        
        ; ЕСТЬ КОЛЛИЗИЯ, ВОЗВРАЩАЕМ АДРЕС ОБЪЕКТА И ЕГО ТИП
        MOV     R1, R0          ; ВОЗВРАЩАЕМ АДРЕС ОБЪЕКТА КОЛЛИЗИИ
        MOV     TYPE(R1), R1    ; ЗАГРУЖАЕМ ТИП ОБЪЕКТА КОЛЛИЗИИ
        
        BR      4$              ; ВЫХОД С НАЙДЕННОЙ КОЛЛИЗИЕЙ

2$:     SOB     R4, 1$          ; ПРОВЕРЯЕМ СЛЕДУЮЩИЙ ОБЪЕКТ

3$:     MOV     #0, R0          ; КОЛЛИЗИЙ НЕ НАЙДЕНО
        MOV     #0, R1          ; ТИП = НЕТ КОЛЛИЗИИ

4$:     MOV     (SP)+, R4
        MOV     (SP)+, R3
        MOV     (SP)+, R2
        RETURN
;=======================================================================
; ПРОВЕРКА КОЛЛИЗИИ С ОКРУЖАЮЩЕЙ СРЕДОЙ (ГРАНИЦЫ ЭКРАНА)
;=======================================================================
; ВХОД:  R0 = АДРЕС ОБЪЕКТА
; ВЫХОД: R0 = НАПРАВЛЕНИЕ КОЛЛИЗИИ (БИТОВЫЕ ФЛАГИ)
COLENV:: MOV     R1, -(SP)
        MOV     R2, -(SP)
        MOV     R3, -(SP)
        
        CLR     R2              ; R2 = ФЛАГИ КОЛЛИЗИЙ
        
        ; ПОЛУЧАЕМ РАЗМЕРЫ ОБЪЕКТА
        MOV     ADSPR(R0), R3
        MOV     SIZEX(R3), R1   ; R1 = SIZEX
        MOV     SIZEY(R3), R3   ; R3 = SIZEY
        
        ; ПРОВЕРКА ЛЕВОЙ ГРАНИЦЫ
        MOV     POSX(R0), R1
        CMP     R1, #10.        ; ЛЕВАЯ ГРАНИЦА ЭКРАНА = 10
        BGT     1$
        BIS     #1, R2          ; УСТАНАВЛИВАЕМ ФЛАГ ЛЕВОЙ КОЛЛИЗИИ

1$:     ; ПРОВЕРКА ПРАВОЙ ГРАНИЦЫ
        MOV     POSX(R0), R1
        ADD     SIZEX(R0), R1   ; ПРАВАЯ ГРАНИЦА ОБЪЕКТА
        CMP     R1, #300.       ; ПРАВАЯ ГРАНИЦА ЭКРАНА = 300
        BLT     2$
        BIS     #2, R2          ; УСТАНАВЛИВАЕМ ФЛАГ ПРАВОЙ КОЛЛИЗИИ

2$:     ; ПРОВЕРКА ВЕРХНЕЙ ГРАНИЦЫ
        MOV     POSY(R0), R1
        CMP     R1, #10.        ; ВЕРХНЯЯ ГРАНИЦА ЭКРАНА = 10
        BGT     3$
        BIS     #4, R2          ; УСТАНАВЛИВАЕМ ФЛАГ ВЕРХНЕЙ КОЛЛИЗИИ

3$:     ; ПРОВЕРКА НИЖНЕЙ ГРАНИЦЫ
        MOV     POSY(R0), R1
        ADD     SIZEY(R0), R1   ; НИЖНЯЯ ГРАНИЦА ОБЪЕКТА
        CMP     R1, #230.       ; НИЖНЯЯ ГРАНИЦА ЭКРАНА = 230
        BLT     4$
        BIS     #10, R2         ; УСТАНАВЛИВАЕМ ФЛАГ НИЖНЕЙ КОЛЛИЗИИ (8)

4$:     MOV     R2, R0          ; ВОЗВРАЩАЕМ ФЛАГИ КОЛЛИЗИЙ
        MOV     (SP)+, R3
        MOV     (SP)+, R2
        MOV     (SP)+, R1
        RETURN
;================================================================================
; РАСШИРЕННАЯ ФУНКЦИЯ КОЛЛИЗИИ С ОПРЕДЕЛЕНИЕМ ТИПА ВЗАИМОДЕЙСТВИЯ
;================================================================================
; ВХОД:  R0 = АДРЕС ОБЪЕКТА 1
;        R1 = АДРЕС ОБЪЕКТА 2  
; ВЫХОД: R0 = РЕЗУЛЬТАТ КОЛЛИЗИИ (0=НЕТ, 1=ВРАГ, 2=ПУЛЯ, 3=БОНУС, 4=ПРЕПЯТСТВИЕ, 
;        5=ВЗАИМОУНИЧТОЖЕНИЕ ПУЛЬ, 6=СТОЛКНОВЕНИЕ ВРАГОВ, 7=УСИЛЕНИЕ ВРАГА,
;        8=ОСТАНОВКА ВРАГА, 9=АКТИВАЦИЯ ЛОВУШКИ, 10=АКТИВАЦИЯ ПОРТАЛА)
COLTYP:: MOV     R2, -(SP)
        MOV     R3, -(SP)
        MOV     R4, -(SP)
        
        CALL    COLCHE          ; СНАЧАЛА ПРОВЕРЯЕМ БАЗОВУЮ КОЛЛИЗИЮ
        TST     R0
        BEQ     16$             ; НЕТ КОЛЛИЗИИ
        
        ; СОХРАНЯЕМ АДРЕСА ОБЪЕКТОВ
        MOV     R0, R2          ; R2 = АДРЕС OBJ1
        MOV     R1, R3          ; R3 = АДРЕС OBJ2
        
        ; ОПРЕДЕЛЯЕМ ТИП ПЕРВОГО ОБЪЕКТА
        MOV     TYPE(R2), R2    ; R2 = ТИП OBJ1
        
        ; ОПРЕДЕЛЯЕМ ТИП ВТОРОГО ОБЪЕКТА
        MOV     TYPE(R3), R3    ; R3 = ТИП OBJ2
        
        ; КОМБИНИРУЕМ ТИПЫ ДЛЯ ОПРЕДЕЛЕНИЯ РЕЗУЛЬТАТА
        
        ; ОСНОВНЫЕ КОМБИНАЦИИ:
        ; ИГРОК + ВРАГ = ВРАГ (УРОН)
        CMP     R2, #TYPPLR     ; OBJ1 = ИГРОК?
        BNE     1$
        CMP     R3, #TYPENM     ; OBJ2 = ВРАГ?
        BNE     2$
        MOV     #TYPENM, R0     ; РЕЗУЛЬТАТ: ВРАГ
        BR      17$

1$:     CMP     R3, #TYPPLR     ; OBJ2 = ИГРОК?
        BNE     4$
        CMP     R2, #TYPENM     ; OBJ1 = ВРАГ?
        BNE     4$
        MOV     #TYPENM, R0     ; РЕЗУЛЬТАТ: ВРАГ
        BR      17$

2$:     CMP     R3, #TYPBNS     ; OBJ2 = БОНУС?
        BNE     3$
        MOV     #TYPBNS, R0     ; РЕЗУЛЬТАТ: БОНУС
        BR      17$

3$:     CMP     R3, #TYPWAL     ; OBJ2 = СТЕНА?
        BNE     4$
        MOV     #TYPWAL, R0     ; РЕЗУЛЬТАТ: ПРЕПЯТСТВИЕ
        BR      17$

4$:     ; ПУЛЯ + ВРАГ = ПУЛЯ (УНИЧТОЖЕНИЕ)
        CMP     R2, #TYPBUL     ; OBJ1 = ПУЛЯ?
        BNE     5$
        CMP     R3, #TYPENM     ; OBJ2 = ВРАГ?
        BNE     6$
        MOV     #TYPBUL, R0     ; РЕЗУЛЬТАТ: ПУЛЯ
        BR      17$

5$:     CMP     R3, #TYPBUL     ; OBJ2 = ПУЛЯ?
        BNE     7$
        CMP     R2, #TYPENM     ; OBJ1 = ВРАГ?
        BNE     7$
        MOV     #TYPBUL, R0     ; РЕЗУЛЬТАТ: ПУЛЯ
        BR      17$

6$:     CMP     R2, #TYPBUL     ; OBJ1 = ПУЛЯ?
        BNE     7$
        CMP     R3, #TYPWAL     ; OBJ2 = СТЕНА?
        BNE     7$
        MOV     #TYPWAL, R0     ; РЕЗУЛЬТАТ: ПРЕПЯТСТВИЕ
        BR      17$

7$:     ; ДОПОЛНИТЕЛЬНЫЕ КОМБИНАЦИИ
        
        ; ПУЛЯ + ПУЛЯ = УНИЧТОЖЕНИЕ ОБЕИХ ПУЛЬ
        CMP     R2, #TYPBUL     ; OBJ1 = ПУЛЯ?
        BNE     10$
        CMP     R3, #TYPBUL     ; OBJ2 = ПУЛЯ?
        BNE     10$
        MOV     #5, R0          ; РЕЗУЛЬТАТ: ВЗАИМНОЕ УНИЧТОЖЕНИЕ ПУЛЬ
        BR      17$

10$:     ; ВРАГ + ВРАГ = ОТТАЛКИВАНИЕ
        CMP     R2, #TYPENM     ; OBJ1 = ВРАГ?
        BNE     11$
        CMP     R3, #TYPENM     ; OBJ2 = ВРАГ?
        BNE     11$
        MOV     #6, R0          ; РЕЗУЛЬТАТ: СТОЛКНОВЕНИЕ ВРАГОВ
        BR      17$

11$:     ; ВРАГ + БОНУС = УСИЛЕНИЕ ВРАГА
        CMP     R2, #TYPENM     ; OBJ1 = ВРАГ?
        BNE     12$
        CMP     R3, #TYPBNS     ; OBJ2 = БОНУС?
        BNE     12$
        MOV     #7, R0          ; РЕЗУЛЬТАТ: УСИЛЕНИЕ ВРАГА
        BR      17$

12$:    ; ВРАГ + СТЕНА = ОСТАНОВКА ВРАГА
        CMP     R2, #TYPENM     ; OBJ1 = ВРАГ?
        BNE     13$
        CMP     R3, #TYPWAL     ; OBJ2 = СТЕНА?
        BNE     13$
        MOV     #8, R0          ; РЕЗУЛЬТАТ: ОСТАНОВКА ВРАГА
        BR      17$

13$:    ; СИММЕТРИЧНЫЕ СЛУЧАИ ДЛЯ ВЫШЕПЕРЕЧИСЛЕННЫХ
        CMP     R2, #TYPBNS     ; OBJ1 = БОНУС?
        BNE     14$
        CMP     R3, #TYPENM     ; OBJ2 = ВРАГ?
        BNE     14$
        MOV     #7, R0          ; РЕЗУЛЬТАТ: УСИЛЕНИЕ ВРАГА
        BR      17$

14$:    CMP     R2, #TYPWAL     ; OBJ1 = СТЕНА?
        BNE     15$
        CMP     R3, #TYPENM     ; OBJ2 = ВРАГ?
        BNE     15$
        MOV     #8, R0          ; РЕЗУЛЬТАТ: ОСТАНОВКА ВРАГА
        BR      17$

15$:    ; НЕИЗВЕСТНАЯ КОМБИНАЦИЯ
        MOV     #0, R0          ; ИГНОРИРОВАТЬ
        BR      17$

16$:    MOV     #0, R0          ; НЕТ КОЛЛИЗИИ

17$:    MOV     (SP)+, R4
        MOV     (SP)+, R3
        MOV     (SP)+, R2
        RETURN
;===============================================================
; ИНИЦИАЛИЗАЦИЯ СИСТЕМЫ КОЛЛИЗИЙ
;===============================================================
COLINIT:: CLR     OBJCNT          ; ОЧИЩАЕМ СЧЕТЧИК ОБЪЕКТОВ
        MOV     #OBJLST, R0
        MOV     #20., R1        ; 20 СЛОВ
1$:     CLR     (R0)+           ; ОЧИЩАЕМ СПИСОК
        SOB     R1, 1$
        RETURN
