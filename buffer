;=========================================================================
; СИСТЕМА КОЛЛИЗИЙ ДЛЯ МНОГИХ ОБЪЕКТОВ
;=========================================================================
; ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ

OBJCNT: .WORD   0               ; СЧЕТЧИК ОБЪЕКТОВ
OBJLST: .BLKW   20              ; СПИСОК АДРЕСОВ ОБЪЕКТОВ (МАКС 20)

; ДОБАВЛЕНИЕ ОБЪЕКТА В СПИСОК ДЛЯ ПРОВЕРКИ КОЛЛИЗИЙ
; ВХОД: R0 = адрес объекта
ADDOBJ: MOV     R1, -(SP)
        MOV     OBJCNT, R1      ; Текущее количество объектов
        CMP     R1, #40.        ; Максимум 20 объектов * 2 байта
        BGE     ADDOBX          ; Если переполнение - выходим
        
        ASL     R1              ; Умножаем на 2 (размер слова)
        MOV     R0, OBJLST(R1)  ; Добавляем адрес в список
        INC     OBJCNT          ; Увеличиваем счетчик
        
ADDOBX: MOV     (SP)+, R1
        RETURN

; УДАЛЕНИЕ ОБЪЕКТА ИЗ СПИСКА
; ВХОД: R0 = адрес объекта
REMOBJ: MOV     R1, -(SP)
        MOV     R2, -(SP)
        MOV     OBJCNT, R1      ; Количество объектов
        BEQ     REMOBX          ; Если список пуст - выходим
        
        MOV     #OBJLST, R2     ; Начало списка
REMLP:  CMP     R0, (R2)+       ; Сравниваем с текущим объектом
        BEQ     REMFND          ; Нашли объект для удаления
        SOB     R1, REMLP       ; Продолжаем поиск
        BR      REMOBX          ; Не нашли - выходим

REMFND: ; Сдвигаем оставшиеся объекты
        MOV     R2, R0          ; R0 = текущая позиция+2
        DEC     R0              ; Возвращаемся к удаляемому элементу
        DEC     R0
        MOV     OBJCNT, R1
        SUB     #OBJLST, R2     ; R2 = индекс текущего элемента
        ASR     R2              ; Делим на 2
        SUB     R2, R1          ; R1 = количество оставшихся элементов
        
SHFTLP: MOV     (R0)+, -2(R0)   ; Сдвигаем элементы
        SOB     R1, SHFTLP
        DEC     OBJCNT          ; Уменьшаем счетчик

REMOBX: MOV     (SP)+, R2
        MOV     (SP)+, R1
        RETURN

; ПРОВЕРКА КОЛЛИЗИИ С ЛЮБЫМ ОБЪЕКТОМ В СПИСКЕ
; ВХОД:  R0 = адрес основного объекта
; ВЫХОД: R0 = адрес объекта коллизии (0 если нет)
;        R1 = тип коллизии (0=нет, 1=враг, 2=препятствие, 3=бонус)
COLANY: MOV     R2, -(SP)       ;сохраняем регистры
        MOV     R3, -(SP)
        MOV     R4, -(SP)
        
        MOV     OBJCNT, R4      ; Количество объектов для проверки
        BEQ     COLANN          ; Если список пуст - выходим
        
        MOV     #OBJLST, R3     ; Указатель на список объектов
        MOV     R0, R2          ; Сохраняем адрес основного объекта
        
COLLP:  MOV     (R3)+, R1       ; Берем следующий объект из списка
        CMP     R1, R2          ; Не проверяем коллизию с самим собой
        BEQ     COLNXT
        
        ; Проверяем коллизию между obj1 (R2) и obj2 (R1)
        MOV     R2, R0
        CALL    COLCHE          ; Вызываем базовую функцию коллизии
        TST     R0
        BEQ     COLNXT          ; Если нет коллизии - следующий объект
        
        ; ОПРЕДЕЛЯЕМ ТИП ОБЪЕКТА КОЛЛИЗИИ
        MOV     R1, R0          ; Возвращаем адрес объекта коллизии
        MOV     #1, R1          ; Предполагаем врага (тип 1)
        
        ; Проверяем тип объекта по его адресу спрайта
        MOV     ADSPR(R0), R3   ; Получаем адрес спрайта объекта
        ; Здесь можно добавить логику определения типа объекта
        ; Например, сравнивать с известными адресами спрайтов врагов, бонусов и т.д.
        
        BR      COLAEX          ; Выход с найденной коллизией

COLNXT: SOB     R4, COLLP       ; Проверяем следующий объект

COLANN: MOV     #0, R0          ; Коллизий не найдено
        MOV     #0, R1          ; Тип = нет коллизии

COLAEX: MOV     (SP)+, R4
        MOV     (SP)+, R3
        MOV     (SP)+, R2
        RTS     PC

; ПРОВЕРКА КОЛЛИЗИИ С ОКРУЖАЮЩЕЙ СРЕДОЙ (СТЕНЫ, ПЛАТФОРМЫ)
; ВХОД:  R0 = адрес объекта
; ВЫХОД: R0 = направление коллизии (битовые флаги: 1=слева, 2=справа, 4=сверху, 8=снизу)
COLENV: MOV     R1, -(SP)
        MOV     R2, -(SP)
        MOV     R3, -(SP)
        
        CLR     R2              ; R2 = флаги коллизий
        
        ; ПРОВЕРКА ЛЕВОЙ ГРАНИЦЫ
        MOV     POSX(R0), R1
        CMP     R1, #10.        ; Левая граница экрана = 10
        BGT     CHKRIG
        BIS     #1, R2          ; Устанавливаем флаг левой коллизии

CHKRIG: ; ПРОВЕРКА ПРАВОЙ ГРАНИЦЫ
        MOV     ADSPR(R0), R3
        MOV     SIZEX(R3), R3   ; Размер объекта по X
        ADD     POSX(R0), R3    ; Правая граница объекта
        CMP     R3, #300.       ; Правая граница экрана = 300
        BLT     CHKTOP
        BIS     #2, R2          ; Устанавливаем флаг правой коллизии

CHKTOP: ; ПРОВЕРКА ВЕРХНЕЙ ГРАНИЦЫ
        MOV     POSY(R0), R1
        CMP     R1, #10.        ; Верхняя граница экрана = 10
        BGT     CHKBOT
        BIS     #4, R2          ; Устанавливаем флаг верхней коллизии

CHKBOT: ; ПРОВЕРКА НИЖНЕЙ ГРАНИЦЫ
        MOV     ADSPR(R0), R3
        MOV     SIZEY(R3), R3   ; Размер объекта по Y
        ADD     POSY(R0), R3    ; Нижняя граница объекта
        CMP     R3, #230.       ; Нижняя граница экрана = 230
        BLT     COLEXE
        BIS     #10, R2         ; Устанавливаем флаг нижней коллизии (8)

COLEXE: MOV     R2, R0          ; Возвращаем флаги коллизий
        MOV     (SP)+, R3
        MOV     (SP)+, R2
        MOV     (SP)+, R1
        RTS     PC

; РАСШИРЕННАЯ ФУНКЦИЯ КОЛЛИЗИИ С УЧЕТОМ ТИПОВ ОБЪЕКТОВ
; ВХОД:  R0 = адрес объекта 1
;        R1 = адрес объекта 2  
; ВЫХОД: R0 = результат (0=нет, 1=враг, 2=пуля, 3=бонус, 4=игрок)
COLTYP: MOV     R2, -(SP)
        MOV     R3, -(SP)
        
        CALL    COLCHE          ; Сначала проверяем базовую коллизию
        TST     R0
        BEQ     COLTNO          ; Нет коллизии
        
        ; ОПРЕДЕЛЯЕМ ТИПЫ ОБЪЕКТОВ
        MOV     #0, R2          ; R2 = тип коллизии
        
        ; Проверяем тип первого объекта
        MOV     ADSPR(R0), R3
        ; Сравниваем с известными типами спрайтов
        CMP     R3, #ENEMYB     ; Это враг?
        BEQ     OBJ1EN
        CMP     R3, #BULLET     ; Это пуля?
        BEQ     OBJ1BL
        CMP     R3, #BONUS      ; Это бонус?
        BEQ     OBJ1BN
        ; Иначе считаем игроком
        MOV     #4, R2          ; Тип = игрок
        BR      CHKOB2

OBJ1EN: MOV     #1, R2          ; Тип = враг
        BR      CHKOB2

OBJ1BL: MOV     #2, R2          ; Тип = пуля  
        BR      CHKOB2

OBJ1BN: MOV     #3, R2          ; Тип = бонус

CHKOB2: ; Аналогично проверяем второй объект
        ; (код аналогичный для R1)
        
        ; В зависимости от комбинации типов определяем результат
        ; Например: враг + игрок = враг (урон)
        ;           пуля + враг = пуля (уничтожение врага)
        ;           игрок + бонус = бонус (сбор бонуса)
        
        MOV     R2, R0          ; Возвращаем тип коллизии

COLTNO: MOV     (SP)+, R3
        MOV     (SP)+, R2
        RTS     PC

; ИНИЦИАЛИЗАЦИЯ СИСТЕМЫ КОЛЛИЗИЙ
COLINIT:CLR     OBJCNT          ; Очищаем счетчик объектов
        MOV     #OBJLST, R0
        MOV     #40., R1        ; 20 слов
CLRLP:  CLR     (R0)+           ; Очищаем список
        SOB     R1, CLRLP
        RTS     PC

;============================================================================

; ОСНОВНОЙ ИГРОВОЙ ЦИКЛ
GAMELP: ; ОБНОВЛЕНИЕ ПОЗИЦИЙ ОБЪЕКТОВ
        ; ...
        
        ; ПРОВЕРКА КОЛЛИЗИЙ ДЛЯ ГЕРОЯ
        MOV     #BOMEN, R0      ; Основной герой
        CALL    COLANY          ; Проверяем коллизии с любыми объектами
        TST     R0
        BEQ     NOHCOL          ; Нет коллизий с объектами
        
        ; ОБРАБОТКА КОЛЛИЗИИ С ОБЪЕКТОМ
        CMP     R1, #1          ; Тип = враг?
        BNE     NOTENM
        CALL    HURTPL          ; Обработка получения урона
        BR      NOHCOL

NOTENM: CMP     R1, #3          ; Тип = бонус?
        BNE     NOHCOL  
        CALL    TAKEBON         ; Подбор бонуса

NOHCOL: ; ПРОВЕРКА КОЛЛИЗИЙ СО СРЕДОЙ
        MOV     #BOMEN, R0
        CALL    COLENV
        TST     R0
        BEQ     NOECOL
        
        ; ОБРАБОТКА КОЛЛИЗИЙ СО СТЕНАМИ
        BIT     #1, R0          ; Коллизия слева?
        BEQ     CHKRC
        MOV     #BOMEN, R0
        MOV     #0, DXS(R0)     ; Останавливаем движение влево

CHKRC:  BIT     #2, R0          ; Коллизия справа?
        BEQ     CHKTP
        MOV     #BOMEN, R0  
        MOV     #0, DXS(R0)     ; Останавливаем движение вправо

CHKTP:  BIT     #4, R0          ; Коллизия сверху?
        BEQ     CHKBT
        MOV     #BOMEN, R0
        MOV     #0, DYS(R0)     ; Останавливаем движение вверх

CHKBT:  BIT     #8, R0          ; Коллизия снизу?
        BEQ     NOECOL
        MOV     #BOMEN, R0
        MOV     #0, DYS(R0)     ; Останавливаем движение вниз
        ; Или обрабатываем как "стоит на земле"

NOECOL: ; ПРОДОЛЖЕНИЕ ИГРОВОГО ЦИКЛА
        ; ...
        
        BR      GAMELP        
